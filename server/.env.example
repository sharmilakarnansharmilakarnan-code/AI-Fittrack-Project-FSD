# Server configuration
PORT=5000

# MongoDB connection string
# Local example:      mongodb://127.0.0.1:27017/ai-fittrack
# Atlas example:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai-fittrack
MONGO_URI=your_mongodb_connection_string

# JWT secret used to sign authentication tokens - use a long, random string (32+ characters)
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_secure_jwt_secret

# JWT token expiry (e.g. 7d, 12h, 30m)
JWT_EXPIRES_IN=7d

# Google Gemini API key (get one from https://aistudio.google.com/app/apikey).
# Only the AI endpoints (POST /api/ai/recommendation and GET /api/ai/fitness-insights) need it;
# if it is missing they answer with a clear JSON error.
GEMINI_API_KEY=your_gemini_api_key

# Gemini model name used by BOTH AI features (must be a model your SDK/API key actually supports)
GEMINI_MODEL=gemini-2.5-flash

# Milliseconds to wait for a Gemini response before aborting the request
GEMINI_TIMEOUT_MS=30000

# Comma separated list of allowed frontend origins for CORS
CLIENT_ORIGIN=http://localhost:5173

# ---- Used only by `npm run create-admin` (or pass them as arguments) ----
# ADMIN_NAME=Administrator
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose_a_strong_password

# ---- Used only by the API test script `npm run test:api` (see README) ----
# TEST_BASE_URL=http://localhost:5000
# TEST_ADMIN_EMAIL=admin@example.com
# TEST_ADMIN_PASSWORD=choose_a_strong_password
